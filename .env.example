# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port. Only for `npm run api`: the API container builds its own connection
# string from MSSQL_SA_PASSWORD, pointing at the "sqlserver" service.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Signs and checks access tokens (HMAC-SHA256, at least 32 bytes). Deliberately blank: there
# is no shared default. For local development keep it in user-secrets instead:
#   dotnet user-secrets set "Jwt:SigningKey" "$(openssl rand -base64 48)" --project apps/api/src/SupportDesk.Presentation
# docker compose passes this to the API container, so set it before `docker compose up`:
#   Jwt__SigningKey=<output of: openssl rand -base64 48>
# The API refuses to start without a key of at least 32 bytes.
Jwt__SigningKey=

# Development turns on Swagger, the automatic migration and the demo seed data. Used by
# `npm run api` and by the API container (docker compose defaults it to Development).
ASPNETCORE_ENVIRONMENT=Development
